local responsiveScale=create("UIScale",{Scale=UI_SCALE},holder)
local uiLayout={mainMoved=false,visibleHeight=WINDOW_HEIGHT}
local function boundPosition(position)
    local camera=workspace.CurrentCamera
    if not camera then return position end
    local viewport,scale=camera.ViewportSize,responsiveScale.Scale
    local halfW,halfH=WINDOW_WIDTH*scale/2,WINDOW_HEIGHT*scale/2
    local shown=(uiLayout.visibleHeight or WINDOW_HEIGHT)*scale
    return UDim2.fromOffset(
        math.clamp(position.X.Scale*viewport.X+position.X.Offset,halfW+8,math.max(halfW+8,viewport.X-halfW-8)),
        math.clamp(position.Y.Scale*viewport.Y+position.Y.Offset,halfH+8,math.max(halfH+8,viewport.Y-shown+halfH-8)))
end
local function clampWindow() holder.Position=boundPosition(holder.Position) end
local function refreshViewport()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local viewport=camera.ViewportSize
    responsiveScale.Scale=math.max(0.05,math.min(UI_SCALE,(viewport.X-32)/WINDOW_WIDTH,(viewport.Y-32)/WINDOW_HEIGHT))
    if not uiLayout.mainMoved then holder.Position=UDim2.fromScale(0.5,0.5) end
    clampWindow()
end
local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect();cameraConnection=nil end
    local camera=workspace.CurrentCamera
    if camera then cameraConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshViewport) end
    refreshViewport()
end
