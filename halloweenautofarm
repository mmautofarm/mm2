local modalPanels={}
local modalNames={shop=true,shopgui=true,shopframe=true,shopmenu=true,
    roundinfo=true,roundinformation=true,roundsummary=true,roundresults=true,
    scoreboard=true,scoreboardphone=true}
local function isBagVisible(object)
    local ancestor=object
    while ancestor and ancestor~=guiParent do
        if ancestor:IsA("LuaSourceContainer") then return false end
        if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
        if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
        ancestor=ancestor.Parent
    end
    return ancestor==guiParent
end
local function indexModal(object)
    if object:IsDescendantOf(screenGui) then return end
    if object:IsA("Frame") or object:IsA("ScrollingFrame") or object:IsA("CanvasGroup") or object:IsA("ScreenGui") then
        local name=string.lower(object.Name):gsub("[^%a]","")
        if modalNames[name] then modalPanels[object]=true end
    end
end
connect(guiParent.DescendantAdded,indexModal)
connect(guiParent.DescendantRemoving,function(object) modalPanels[object]=nil end)
discoverTree(guiParent,indexModal)
local function bagActionsBlocked()
    if isRoundOver() or not liveRoundHud() then return true end
    -- Unrelated shop frames can stay Visible even with no menu on screen.
    -- Counter visibility and provenance are checked separately below.
    return false
end
local function clearBagObservation()
