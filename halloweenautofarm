local trackedBagLabel=nil
local lastBagScan=0
local function labelContext(object)
    local parts = { object.Name }
    local ancestor = object.Parent
    for _ = 1, 6 do
        if not ancestor then break end
        table.insert(parts, ancestor.Name)
        ancestor = ancestor.Parent
    end
    return string.lower(table.concat(parts, " "))
end

local function parseBagText(object)
    if object:IsDescendantOf(screenGui) or not isBagVisible(object) then return nil end
    if not (object:IsA("TextLabel") or object:IsA("TextButton")) then
        return nil
    end

    local ancestor=object
    while ancestor and ancestor~=guiParent do
        local name=string.lower(ancestor.Name):gsub("[^%a]","")
        if name:find("shop",1,true) or name:find("scoreboard",1,true)
            or name:find("roundinfo",1,true) or name:find("roundsummary",1,true)
            or name:find("roundresults",1,true) then return nil end
        ancestor=ancestor.Parent
    end
    local text = object.Text or ""
    -- Rich text markup and thousands separators must not break the parse.
    text = string.gsub(text, "<[^<>]->", "")
    text = string.gsub(text, ",", "")
    local fullText=string.lower(text):gsub("[^%a]","")
    if fullText=="full" or fullText=="bagfull" then
        local context=labelContext(object)
        if context:find("coinbags",1,true) then return BAG_LIMIT_DEFAULT,BAG_LIMIT_DEFAULT end
    end
    local currentText, capacityText = string.match(text, "^%s*(%d+)%s*/%s*(%d+)%s*$")
    if currentText then
        return tonumber(currentText), tonumber(capacityText)
    end

    local plain = string.match(text, "^%s*(%d+)%s*$")
    if plain then
        return tonumber(plain), nil
    end

    return nil
end

-- Exact counter location, confirmed by scanning the real MM2 interface:
-- MainGUI.Game.CoinBags.Container.<Coin/Candy/BeachBall/Egg/SnowToken>
--     .CurrencyFrame.Icon.Coins
local trackedBagContainer = nil


local function findCoinBagContainer(playerGui)
    -- Reuse the container while it is still alive.
    if trackedBagContainer and trackedBagContainer:IsDescendantOf(playerGui) then
        return trackedBagContainer
    end
    trackedBagContainer = nil

    -- Exact, confirmed path first.
    local mainGui = playerGui:FindFirstChild("MainGUI")
    local gameFrame = mainGui and mainGui:FindFirstChild("Game")
    local coinBags = gameFrame and gameFrame:FindFirstChild("CoinBags")
    local container = coinBags and coinBags:FindFirstChild("Container")
    if container then
        trackedBagContainer = container
        return container
    end

    return nil -- alternative containers are found by the background scan
end

local function findCoinBagLabel(playerGui)
    local container = findCoinBagContainer(playerGui)
    if not container then return nil end

    local fallbackLabel = nil
    for _, bag in ipairs(container:GetChildren()) do
        if bag:IsA("GuiObject") then
            local currencyFrame = bag:FindFirstChild("CurrencyFrame")
            local icon = currencyFrame and currencyFrame:FindFirstChild("Icon")
            local label = icon and icon:FindFirstChild("Coins")
            if not label then
                -- Layout inside the bag changed: search the whole bag.
                label = bag:FindFirstChild("Coins", true)
            end
            if label and label:IsA("TextLabel") then
                -- Event bags (Candy, BeachBall, ...) are hidden outside
                -- their events, so prefer the bag that is shown right now.
                if isBagVisible(label) and parseBagText(label)~=nil then
                    if bag.Name == "Candy" then return label end
                    fallbackLabel = fallbackLabel or label
                end
            end
            -- The numeric counter may be hidden when the Full indicator appears.
            local full=bag:FindFirstChild("Full",true)
            if full and full:IsA("TextLabel") and isBagVisible(full) then
                if parseBagText(full)~=nil then
                    if bag.Name=="Candy" then return full end
                    fallbackLabel=fallbackLabel or full
                end
            end
        end
    end
    return fallbackLabel -- only visible, parseable counters are eligible
end

local function bagShowsFull(label)
    local bag=label
    while bag and bag.Parent~=trackedBagContainer do bag=bag.Parent end
    local fullLabel = bag and bag:FindFirstChild("Full",true)
    if fullLabel and fullLabel:IsA("TextLabel") then
        return isBagVisible(fullLabel)
    end
    return false
end

local announcedBagPath = nil
local function announceBagLabel(label)
    local path = label:GetFullName()
    if path ~= announcedBagPath then
        announcedBagPath = path
        print("[MM2 AUTOFARM] coin counter found:", path)
    end
end

local bagSearchThread=nil
stopBagSearch=function()
    if bagSearchThread then pcall(task.cancel,bagSearchThread); bagSearchThread=nil end
end
local function startBagSearch()
    if bagSearchThread or os.clock()-lastBagScan<1.5 then return end
    lastBagScan=os.clock()
    bagSearchThread=task.defer(function()
        local deadline=os.clock()+0.0005
        local operations=0
        local function budget()
            operations+=1
            if operations>=32 or os.clock()>=deadline then
                RunService.Heartbeat:Wait()
                operations=0
                deadline=os.clock()+0.0005
            end
        end
        local ok,bestLabel=pcall(function()
            for object in pairs(bagRoots) do
                if object.Name=="CoinBags" and object:IsDescendantOf(guiParent) then
                    trackedBagContainer=object:FindFirstChild("Container") or object
                    break
                end
                budget()
            end
            local chosen,bestScore=nil,0
            for object in pairs(bagLabels) do
                local current,capacity=parseBagText(object)
                if current and object.Visible then
                    local context=labelContext(object)
                    local score=0
                    if context:find("coin",1,true) then score+=4 end
                    if context:find("bag",1,true) then score+=3 end
                    if context:find("candy",1,true) then score+=2 end
                    if context:find("currency",1,true) then score+=1 end
                    if object.Name=="Coins" then score+=4 end
                    if capacity==BAG_LIMIT_DEFAULT or capacity==50 then score+=5 end
                    if (capacity or score>=3) and score>bestScore then chosen,bestScore=object,score end
                end
                budget()
            end
            return chosen
        end)
        -- Never replace an exact HUD counter found while this scan was yielding.
        if state.alive and ok and bestLabel and not trackedBagLabel and parseBagText(bestLabel)~=nil then
            trackedBagLabel=bestLabel
            announceBagLabel(bestLabel)
        end
        bagSearchThread=nil
    end)
end
local function scanBagFromInterface()
    -- Re-evaluate the active event bag before reusing a cached normal coin bag.
    local activeLabel=findCoinBagLabel(guiParent)
    if activeLabel then
        trackedBagLabel=activeLabel
        announceBagLabel(activeLabel)
        return parseBagText(activeLabel)
    end
    -- Reuse the label found earlier while it is still on screen.
    if trackedBagLabel and trackedBagLabel.Parent then
        local current, capacity = parseBagText(trackedBagLabel)
        if current then
            return current, capacity
        end
    end
    trackedBagLabel = nil

    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    -- The exact counter path goes first: it is instant and precise.
    local exactLabel = findCoinBagLabel(playerGui)
    if exactLabel then
        local current, capacity = parseBagText(exactLabel)
        if current then
            trackedBagLabel = exactLabel
            announceBagLabel(exactLabel)
            return current, capacity
        end
    end

    startBagSearch()
    return nil
end

local function updateBagFromInterface()
    local current,capacity=scanBagFromInterface()
    local label=trackedBagLabel
    if current==nil then clearBagObservation(); return end
    local same=lastSeenBagLabel==label
    if not same or (lastSeenBagCount and current<lastSeenBagCount) then
        state.freshBagProgress=false
        bagFullConfirmations=0
    end
    if current==0 then bagKillTriggered=false end
    if same and lastSeenBagCount~=nil and current>lastSeenBagCount then
        state.farmed+=current-lastSeenBagCount
        state.freshBagProgress=true
    end
    lastSeenBagLabel=label
    lastSeenBagCount=current
    state.bagFound=true
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    local context=labelContext(label)
    local currencyContext=context:find("coin",1,true) or context:find("candy",1,true) or context:find("currency",1,true)
    local bagContext=context:find("bag",1,true) or label.Name=="Coins"
    -- Broad lookup is for display. Automatic actions need stronger evidence.
    state.bagTrusted=not not (currencyContext and bagContext) and current>=0 and current<=50
        and trackedBagContainer~=nil and label:IsDescendantOf(trackedBagContainer)
        and not bagActionsBlocked() and humanoid~=nil and humanoid.Health>0
    if not state.bagTrusted then
        state.freshBagProgress=false
        bagFullConfirmations=0
    end
    state.actualBagCount=current
    state.bagCount=current
    state.bagLimit=BAG_LIMIT_DEFAULT
    if bagShowsFull(label) then state.bagCount=math.max(current,state.bagLimit) end
end
local function stopAutofarmOnDeath(character)
    bagKillTriggered = false
    clearBagObservation()
    bagCheckEnabledAt=os.clock()
    if state.autofarm then
        state.farmPaused = true
        state.pauseReason = "RESPAWN"
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
    if not state.alive or not humanoid then return end

    connect(humanoid.Died, function()
        currentTarget = nil
        state.farmPaused = state.autofarm
        state.pauseReason = state.autofarm and "RESPAWN" or ""
        restoreCharacter()
    end)
end

if player.Character then
    task.defer(stopAutofarmOnDeath, player.Character)
end
connect(player.CharacterAdded, stopAutofarmOnDeath)

makeToggleCard(116,"Auto Respawn","",Theme.Coral,Theme.Gold,function(enabled)
    state.dieOnFullBag=enabled
    clearBagObservation()

    bagCheckEnabledAt=os.clock()
end)
local function killCharacterWhenBagIsFull()
    if bagKillTriggered or not state.autofarm or not state.dieOnFullBag or not state.bagTrusted
        or bagActionsBlocked() or os.clock()-bagCheckEnabledAt<3
        or (state.bagCount or 0)<state.bagLimit then
        bagFullConfirmations=0
        return
    end
    bagFullConfirmations+=1
    if bagFullConfirmations<3 then return end
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health<=0 then return end
    bagKillTriggered=true
    bagFullConfirmations=0
    state.freshBagProgress=false
    currentTarget=nil
    state.farmPaused=true
    state.pauseReason="RESET"
    restoreCharacter()
    humanoid.Health=0
    humanoid:ChangeState(Enum.HumanoidStateType.Dead)
    character:BreakJoints()
end
state.ready=true
local statsAccumulator=0
connect(RunService.Heartbeat,function(deltaTime)
    if not state.alive then return end
    statsAccumulator+=deltaTime
    if statsAccumulator < 0.2 then return end
    statsAccumulator=0
    updateBagFromInterface()
    killCharacterWhenBagIsFull()
    if state.minimized then return end
    local seconds=math.max(0,math.floor(os.clock()-state.sessionStarted))
    ui:syncStatus()
    ui:write(bagStat,"Text",state.bagFound and (state.bagCount.." / "..state.bagLimit) or ("? / "..state.bagLimit))
    ui:write(collectedStat,"Text",tostring(state.farmed))
    ui:write(timeStat,"Text",string.format("%02d:%02d:%02d",math.floor(seconds/3600),math.floor(seconds/60)%60,seconds%60))
    ui:write(rateStat,"Text",string.format("%.0f",state.farmed*3600/math.max(1,seconds)))
    ui:write(bagFill,"Size",UDim2.fromScale(state.bagFound and math.clamp(state.bagCount/state.bagLimit,0,1) or 0,1))
end)
