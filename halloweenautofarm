local function bindCharacterParts(character)
    clearCharacterHooks()
    table.clear(collisionCache)
    local function add(part)
        if part:IsA("BasePart") then characterParts[part] = true end
    end
    table.insert(characterHooks, character.DescendantAdded:Connect(add))
    table.insert(characterHooks, character.DescendantRemoving:Connect(function(part)
        characterParts[part] = nil
        if collisionCache[part] ~= nil then
            part.CanCollide = collisionCache[part]
            collisionCache[part] = nil
        end
    end))
    for _, part in ipairs(character:GetDescendants()) do add(part) end
end
