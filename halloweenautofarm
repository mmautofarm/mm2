-- Cluster-aware pick: prefer close coins sitting in dense groups, so the
-- route sweeps whole clusters instead of zigzagging across the map.
local CLUSTER_RADIUS = 24
local CLUSTER_BONUS = 7

-- Perf: the picker briefly reuses its last result (no full rescan every
-- frame while idle), caches part positions once per scan instead of touching
-- the .Position property O(n^2) times, and prunes candidates that cannot
-- mathematically beat the current best. Selection results are identical.
-- Search work is spread across frames; movement only consumes a completed result.
local lastPickTime=-math.huge
local lastPickCoin,lastPickScore=nil,math.huge
local randomVisited=setmetatable({}, {__mode="k"})
local pickerRandom=Random.new()
local pickThread=nil
stopPicker=function()
    if pickThread then pcall(task.cancel,pickThread); pickThread=nil end
    lastPickCoin=nil
    lastPickTime=-math.huge
end
local function findClosestItem(rootPart,immediate)
    local now=os.clock()
    if immediate then stopPicker() end
    if not pickThread and now-lastPickTime>=0.35 then
        lastPickTime=now
        local mode=state.selectionMode
        local origin=rootPart.Position
        local function scan()
            local deadline=os.clock()+0.00075
            local operations=0
            local function budget()
                if immediate and mode~="Cluster" then return end
                operations+=1
                if operations>=64 or os.clock()>=deadline then
                    RunService.Heartbeat:Wait()
                    operations=0
                    deadline=os.clock()+0.00075
                end
            end
            local ok,best,score=pcall(function()
                for coin,timestamp in pairs(coinBlacklist) do
                    if not coin.Parent or os.clock()-timestamp>1.5 then coinBlacklist[coin]=nil end
                    budget()
                end
                local candidates={}
                local nearest,nearestDistance=nil,math.huge
                local randomAny,randomFresh=nil,nil
                local anyCount,freshCount=0,0
                for coin in pairs(coinSet) do
                    if isCoinAvailable(coin) and not coinBlacklist[coin] then
                        local position=coin.Position
                        local distance=(position-origin).Magnitude
                        if distance<=MAX_FARM_DISTANCE then
                            if distance<nearestDistance then nearest,nearestDistance=coin,distance end
                            if mode=="Cluster" then table.insert(candidates,{coin=coin,position=position,distance=distance}) end
                            if mode=="Random" then
                                anyCount+=1
                                if pickerRandom:NextInteger(1,anyCount)==1 then randomAny=coin end
                                if not randomVisited[coin] then
                                    freshCount+=1
                                    if pickerRandom:NextInteger(1,freshCount)==1 then randomFresh=coin end
                                end
                            end
                        end
                    end
                    budget()
                end
                if mode=="Nearest" then return nearest,nearestDistance end
                if mode=="Random" then
                    if not randomFresh and randomAny then table.clear(randomVisited) end
                    local chosen=randomFresh or randomAny
                    return chosen,chosen and (chosen.Position-origin).Magnitude or math.huge
                end
                local chosen,bestScore=nearest,nearestDistance
                for _,candidate in ipairs(candidates) do
                    if candidate.distance-6*CLUSTER_BONUS<bestScore then
                        local neighbors=0
                        for _,other in ipairs(candidates) do
                            if other~=candidate and (other.position-candidate.position).Magnitude<=CLUSTER_RADIUS then
                                neighbors+=1
                                if neighbors>=6 then break end
                            end
                            budget()
                        end
                        local value=candidate.distance-neighbors*CLUSTER_BONUS
                        if value<bestScore then chosen,bestScore=candidate.coin,value end
                    end
                    budget()
                end
                return chosen,bestScore
            end)
            if state.alive and state.selectionMode==mode then
                lastPickCoin=ok and best or nil
                lastPickScore=ok and score or math.huge
            end
            pickThread=nil
        end
        if immediate and mode~="Cluster" then scan() else pickThread=task.defer(scan) end
    end
    local coin=lastPickCoin
    if isCoinAvailable(coin) and not coinBlacklist[coin] then
        local distance=(coin.Position-rootPart.Position).Magnitude
        if distance<=MAX_FARM_DISTANCE then
            if state.selectionMode=="Random" then randomVisited[coin]=true end
            return coin,distance,lastPickScore
        end
    end
    return nil,math.huge,math.huge
end

local function isRoundOver()
    -- The end-of-round scoreboard (Scoreboard / Scoreboard_Phone) becomes
    -- visible when the round finishes; farming must pause immediately.
    for _, guiName in ipairs({ "Scoreboard", "Scoreboard_Phone" }) do
        local scoreboard = guiParent:FindFirstChild(guiName)
        if scoreboard and scoreboard:IsA("ScreenGui") and scoreboard.Enabled then
            for _, modeFrame in ipairs(scoreboard:GetChildren()) do
                if modeFrame:IsA("GuiObject") and modeFrame.Visible then
                    return true
                end
            end
        end
    end
    return false
end

local collisionNext=0
local function stabilizeFlight(humanoid,rootPart)
    -- Restore the original camera transparency behavior requested by the user.
    characterModified=true
    if os.clock()>=cameraRetryAt and player.DevCameraOcclusionMode~=Enum.DevCameraOcclusionMode.Invisicam then
        cameraRetryAt=os.clock()+1
        pcall(function() player.DevCameraOcclusionMode=Enum.DevCameraOcclusionMode.Invisicam end)
    end
    if os.clock()>=collisionNext then
        collisionNext=os.clock()+1/30
        for part in pairs(characterParts) do
            if part.Parent then
                if collisionCache[part]==nil then collisionCache[part]=part.CanCollide end
                if part.CanCollide then part.CanCollide=false end
            end
        end
    end
    if not humanoid.PlatformStand then humanoid.PlatformStand=true end
    humanoid.AutoRotate=false

end

local function updateFlight(deltaTime)
    if not state.alive then return end

    if not state.ready then return end
    if not state.autofarm then
        resetFlightEntry()
        state.farmPaused = false
        state.pauseReason = ""
        return
    end

    local character = player.Character
    if not character then
        state.farmPaused = true
        state.pauseReason = "RESPAWN"
        return
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid or humanoid.Health <= 0 then
        state.farmPaused = true
        state.pauseReason = "RESPAWN"
        return
    end

    -- Round finished: stop moving and stop counting until the next round.
    if isRoundOver() then
        roundHudWasActive=false
        resetFlightEntry()
        if not roundEnded then
            roundEnded = true

            for coin in pairs(coinSet) do roundRetiredCoins[coin] = true end
            registryVersion += 1
        end
        -- Observe disabled/hidden pooled pickups while the scoreboard is up.
        if os.clock() >= roundObserveAt then
            roundObserveAt = os.clock() + 0.2
            if roundCursor and not coinSet[roundCursor] then roundCursor=nil end
            for _=1,24 do
                roundCursor=next(coinSet,roundCursor)
                if not roundCursor then break end
                isCoinAvailable(roundCursor)
            end
        end
        currentTarget = nil
        state.farmPaused = true
        state.pauseReason = "ROUND END"
        restoreCharacter()
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        return
    end

    roundEnded = false
    local roundActive=liveRoundHud()
    if roundActive and not roundHudWasActive then
        -- Reused map pickups belong to the new round; discard old exclusions.
        table.clear(roundRetiredCoins)
        table.clear(deadCoins)
        table.clear(coinTouchFails)
        table.clear(coinBlacklist)
        table.clear(availabilityCache)
        table.clear(randomVisited)
        stopPicker()
        resetFlightEntry()
        currentTarget=nil
    end
    roundHudWasActive=roundActive
    if not roundActive then
        state.farmPaused=true
        state.pauseReason="WAITING FOR ROUND"
        resetFlightEntry()
        restoreCharacter()
        return
    end
    -- Re-enter after a large server-side move (e.g. lobby -> map).
    if previousFlightPosition and (rootPart.Position-previousFlightPosition).Magnitude>80 then
        resetFlightEntry()
        currentTarget=nil
    end
    previousFlightPosition=rootPart.Position

    -- Enter only near live map pickups; a visible HUD alone also occurs in lobby.
    if not flightReady then
        local now=os.clock()
        local immediate=entryScanVersion~=registryVersion or now>=entryScanAt
        if immediate then
            entryScanAt=now+0.1
            entryScanVersion=registryVersion
            table.clear(availabilityCache)
        end
        local candidate,candidateDistance=findClosestItem(rootPart,immediate)
        if not candidate or candidateDistance>80 then
            state.farmPaused=true
            state.pauseReason="WAITING FOR MAP PICKUPS"
            restoreCharacter()
            return
        end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={character}
        local ground=workspace:Raycast(rootPart.Position,Vector3.new(0,-20,0),params)
        local ancestor=ground and ground.Instance
        while ancestor and ancestor~=workspace do
            if string.lower(ancestor.Name):find("lobby",1,true) then
                state.farmPaused=true
                state.pauseReason="LOBBY"
                restoreCharacter()
                return
            end
            ancestor=ancestor.Parent
        end
        -- Initial waiting height; movement then follows the active pickup's height.
        flightHeight=flightHeight or ((ground and ground.Position.Y or rootPart.Position.Y)-FLY_BELOW_OFFSET)
        if flightHeight<=workspace.FallenPartsDestroyHeight+20 then
            state.farmPaused=true
            state.pauseReason="SPAWN TOO CLOSE TO VOID"
            restoreCharacter()
            return
        end
        state.farmPaused=true
        state.pauseReason=""
        flightReady=true
        currentTarget=candidate
        stabilizeFlight(humanoid,rootPart)
        flightRoot=rootPart
        flightPose=rootPart.CFrame
    end
    stabilizeFlight(humanoid,rootPart)
    -- Revalidate the live target every frame, not just its Parent reference.
    if currentTarget then availabilityCache[currentTarget]=nil end
    if not isCoinAvailable(currentTarget) or coinBlacklist[currentTarget] then
        local candidate, candidateDistance = findClosestItem(rootPart,currentTarget~=nil)

        if candidate and candidateDistance <= MAX_FARM_DISTANCE then
            currentTarget = candidate
            state.farmPaused = false
            state.pauseReason = ""
        else
            currentTarget = nil
            state.farmPaused = true
            state.pauseReason = candidate and "TOO FAR" or "WAITING"
        end
    end

    -- Mid-flight retarget: if a clearly better coin appeared (fresh spawn or
    -- a dense cluster nearby), switch to it instead of finishing a bad route.
    retargetAccumulator += deltaTime
    if state.selectionMode~="Random" and currentTarget and retargetAccumulator >= 0.5 then
        retargetAccumulator = 0
        local candidate, candidateDistance, candidateScore = findClosestItem(rootPart)
        if candidate and candidate ~= currentTarget and candidateDistance <= MAX_FARM_DISTANCE then
            local currentDistance = (currentTarget.Position - rootPart.Position).Magnitude
            -- Hysteresis: never abandon a coin we are about to grab -
            -- that caused the annoying last-moment turn-aways.
            if currentDistance > 15 and candidateScore + 12 < currentDistance then
                currentTarget = candidate
            end
        end
    end

    local target = currentTarget
    if not isCoinAvailable(target) then
        currentTarget = nil
        state.farmPaused = true
        state.pauseReason = "WAITING"
        return
    end
    local floorLimit=workspace.FallenPartsDestroyHeight+20
    local targetPosition=Vector3.new(target.Position.X,target.Position.Y-FLY_BELOW_OFFSET,target.Position.Z)
    if targetPosition.Y<=floorLimit then
        state.farmPaused=true
        state.pauseReason="TARGET BELOW VOID LIMIT"
        coinBlacklist[target]=os.clock()+10
        currentTarget=nil
        return
    end
    local origin=flightPose and flightPose.Position or rootPart.Position
    local offset = targetPosition - origin
    local distance = offset.Magnitude

    if distance > MAX_FARM_DISTANCE then
        currentTarget = nil
        state.farmPaused = true
        state.pauseReason = "TOO FAR"
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        return
    end

    state.farmPaused = false
    state.pauseReason = ""

    if distance <= 0.45 then
        -- Reach the coin hitbox from under the map.
        if fireTouch then
            pcall(fireTouch, rootPart, target, 0)
            pcall(fireTouch, rootPart, target, 1)
        end
        coinBlacklist[target] = os.clock()
        -- A real coin disappears right after a touch. One that survives
        -- several touch rounds is a dead hitbox - retire it for good.
        -- Never count failures while the bag is full: nothing can be
        -- collected then and every coin would get wrongly retired.
        local bagFull = state.bagFound and state.bagLimit > 0
            and state.bagCount >= state.bagLimit
        if not bagFull then
            coinTouchFails[target] = (coinTouchFails[target] or 0) + 1
            if coinTouchFails[target] >= 3 then
                deadCoins[target] = true
            end
        end
        -- Pick the next destination now, without waiting for the 0.35s scan timer.
        currentTarget=findClosestItem(rootPart,true)
        if not currentTarget then return end
        targetPosition=Vector3.new(currentTarget.Position.X,currentTarget.Position.Y-FLY_BELOW_OFFSET,currentTarget.Position.Z)
        if targetPosition.Y<=floorLimit then
            coinBlacklist[currentTarget]=os.clock()+10
            currentTarget=nil
            return
        end
        offset=targetPosition-origin
        distance=offset.Magnitude
    end

    if distance <= 0.001 then return end

    local safeDelta = math.min(deltaTime, 1 / 30)
    local step = math.min(state.farmSpeed * safeDelta, math.max(distance - 0.1, 0))
    local nextPosition = origin + offset.Unit * step
    -- Remember the current flight height.
    flightHeight=nextPosition.Y

    -- Upright flight: smoothly turn toward the target without pitching the body.
    local flatOffset = Vector3.new(offset.X, 0, offset.Z)
    if flatOffset.Magnitude > 0.05 then
        local desiredRotation=CFrame.lookAt(Vector3.zero,flatOffset.Unit).Rotation
        local rotation=(flightPose or rootPart.CFrame).Rotation:Lerp(desiredRotation,1-math.exp(-10*safeDelta))
        flightPose=rotation+nextPosition
    else
        flightPose = (flightPose or rootPart.CFrame).Rotation + nextPosition
    end
end

-- A single CFrame writer: physics displacement never feeds back into the route.
farmConnection=RunService.PostSimulation:Connect(function(deltaTime)
    updateFlight(deltaTime)
    if state.alive and state.autofarm and characterModified and flightReady
        and flightPose and flightRoot and flightRoot.Parent==player.Character then
        flightRoot.AssemblyLinearVelocity=Vector3.zero
        flightRoot.AssemblyAngularVelocity=Vector3.zero
        flightRoot.CFrame=flightPose
        previousFlightPosition=flightPose.Position
    end
end)

